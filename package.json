{
  "name": "zencastr-cache-service",
  "version": "1.0.0",
  "description": "High-performance caching service similar to Redis/Memcached",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/src/server/index.js",
    "dev": "ts-node-dev --respawn --transpile-only src/server/index.ts",
    "test": "jest",
    "test:watch": "jest --watch",
    "client": "ts-node src/client/cli.ts",
    "docker:build": "docker build -t zencastr-cache .",
    "docker:run": "docker run -p 6379:6379 -p 8080:8080 zencastr-cache",
    "docker": "docker-compose up --build",
    "docker:detached": "docker-compose up -d"
  },
  "keywords": [
    "cache",
    "lru",
    "performance",
    "typescript"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@types/dotenv": "^6.1.1",
    "@types/jest": "^29.5.5",
    "@types/node": "^20.8.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.1",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.2.2"
  },
  "dependencies": {
    "dotenv": "^17.2.2",
    "msgpack-lite": "^0.1.26"
  }
}
