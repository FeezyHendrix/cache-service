# Cache Configuration
CACHE_MAX_SIZE=10000
CACHE_DEFAULT_TTL=3600000
CACHE_ENABLE_METRICS=true
CACHE_MAX_KEY_SIZE=256
CACHE_MAX_VALUE_SIZE=1048576

# Server Configuration
TCP_PORT=6379
HTTP_PORT=8080
TCP_HOST=0.0.0.0
HTTP_HOST=0.0.0.0

# Environment
NODE_ENV=development

# Logging
LOG_LEVEL=info
LOG_FORMAT=json

# Performance
CLEANUP_INTERVAL=30000
MAX_CONNECTIONS=1000
REQUEST_TIMEOUT=5000

# Security
ENABLE_CORS=true
CORS_ORIGIN=*
API_RATE_LIMIT=1000

# Monitoring
ENABLE_HEALTH_CHECK=true
METRICS_ENDPOINT=/stats
HEALTH_ENDPOINT=/health